# Copy to .env.local. Everything prefixed NEXT_PUBLIC_ is shipped to the browser —
# never put secrets here.

# "mock" (default) uses the in-browser mock adapter. "api" is reserved for the
# future HTTP adapters (not implemented yet; the app falls back to mock data).
NEXT_PUBLIC_DATA_SOURCE=mock

# Base URL of the Go API, e.g. https://api.chefarena.example/v1
NEXT_PUBLIC_API_BASE_URL=

# WebSocket gateway for live verdicts and standings, e.g. wss://api.chefarena.example/ws
NEXT_PUBLIC_WS_BASE_URL=
